APP_ENV=local
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5433/ledgerline

# Fake processor (Phase 2). No network, no API keys -- the outcome is whatever you
# say it is, which is what makes the failure path testable on demand.
# PROCESSOR_OUTCOME: success | failure   (the default outcome of every charge)
# PROCESSOR_LATENCY_MS: milliseconds the adapter pretends to take
# Both can be overridden per request with "force_outcome" / "force_latency_ms".
PROCESSOR_OUTCOME=success
PROCESSOR_LATENCY_MS=0

# Concurrency strategies (Phase 4). The naive values are deliberately preserved
# broken code, kept runnable so the before/after stays a measurement. Not defaults,
# and not production paths -- see app/strategies.py.
# IDEMPOTENCY_CLAIM_STRATEGY: locked | naive
# WITHDRAWAL_GUARD: row_lock | naive
# NAIVE_RACE_WINDOW_MS: widens the check-then-act window on the naive paths only

# Durability (Phase 5a). Whether the charge attempt is committed BEFORE the
# processor is called. 'single_txn' is the Phases 2-4 flow, preserved so the crash
# that loses a charged card can be reproduced rather than described.
# CHARGE_DURABILITY: durable_intent | single_txn
CHARGE_DURABILITY=durable_intent

# Reconciliation (Phase 5a). How long a payment may sit in 'processing' before the
# sweep treats it as abandoned by the request that created it -- a threshold on our
# own crash recovery, not a timeout on the processor. Run the sweep with
# `python -m app.reconcile`.
RECONCILE_STUCK_AFTER_SECONDS=60
RECONCILE_INTERVAL_SECONDS=10
# RECONCILE_BATCH_SIZE: most payments one pass will settle (default 100)

# The outbox publisher (Phase 5b). Events are written by the transaction that moves
# the money and drained afterwards by `python -m app.publisher`. The interval is the
# upper bound on how stale a downstream consumer's view can be, and nothing more --
# the event itself is committed with the money and is not at risk while it waits.
OUTBOX_INTERVAL_SECONDS=5
# OUTBOX_BATCH_SIZE: most events one pass will publish (default 100)

# Drift detection (Phase 6). How settled a payment must be before the drift job
# compares it against the processor's books -- not a performance knob, but what
# stops normal in-flight work being reported as a discrepancy. Run it with
# `python -m app.drift --once`; it reports and never repairs.
DRIFT_GRACE_SECONDS=60
# DRIFT_BATCH_SIZE: most payments one pass will examine (default 500)

# --- Hardening and observability (Phase 7) ------------------------------------
# APP_ENV has teeth from Phase 7 on. Setting it to 'production':
#   * disables the fake processor's test knobs (force_outcome, force_latency_ms,
#     force_crash_after_processor) unless ALLOW_TEST_AFFORDANCES says otherwise;
#   * REFUSES TO START if any deliberately-broken strategy path is selected.
# APP_ENV: local | ci | staging | production
APP_ENV=local

# Leave unset to derive from APP_ENV, which is the safe direction: a deployment
# that forgets this still refuses the knobs. Set it true on a staging box where
# the smoke scripts should run against a real deployment.
# ALLOW_TEST_AFFORDANCES=true

# In-process, per-machine. Not a distributed limiter -- see app/ratelimit.py for
# exactly what that does and does not buy.
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=600
RATE_LIMIT_WINDOW_SECONDS=60

# json in a deployment (an ingester reads it), text locally (a person does).
LOG_FORMAT=text
LOG_LEVEL=INFO

# Comma-separated, empty for none. This is an API with no browser client, and an
# allow-list that starts permissive is one nobody ever tightens.
CORS_ALLOW_ORIGINS=
