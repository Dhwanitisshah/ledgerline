APP_ENV=local
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5433/ledgerline

# Fake processor (Phase 2). No network, no API keys -- the outcome is whatever you
# say it is, which is what makes the failure path testable on demand.
# PROCESSOR_OUTCOME: success | failure   (the default outcome of every charge)
# PROCESSOR_LATENCY_MS: milliseconds the adapter pretends to take
# Both can be overridden per request with "force_outcome" / "force_latency_ms".
PROCESSOR_OUTCOME=success
PROCESSOR_LATENCY_MS=0
