APP_ENV=local
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5433/ledgerline

# Fake processor (Phase 2). No network, no API keys -- the outcome is whatever you
# say it is, which is what makes the failure path testable on demand.
# PROCESSOR_OUTCOME: success | failure   (the default outcome of every charge)
# PROCESSOR_LATENCY_MS: milliseconds the adapter pretends to take
# Both can be overridden per request with "force_outcome" / "force_latency_ms".
PROCESSOR_OUTCOME=success
PROCESSOR_LATENCY_MS=0

# Concurrency strategies (Phase 4). The naive values are deliberately preserved
# broken code, kept runnable so the before/after stays a measurement. Not defaults,
# and not production paths -- see app/strategies.py.
# IDEMPOTENCY_CLAIM_STRATEGY: locked | naive
# WITHDRAWAL_GUARD: row_lock | naive
# NAIVE_RACE_WINDOW_MS: widens the check-then-act window on the naive paths only

# Durability (Phase 5a). Whether the charge attempt is committed BEFORE the
# processor is called. 'single_txn' is the Phases 2-4 flow, preserved so the crash
# that loses a charged card can be reproduced rather than described.
# CHARGE_DURABILITY: durable_intent | single_txn
CHARGE_DURABILITY=durable_intent

# Reconciliation (Phase 5a). How long a payment may sit in 'processing' before the
# sweep treats it as abandoned by the request that created it -- a threshold on our
# own crash recovery, not a timeout on the processor. Run the sweep with
# `python -m app.reconcile`.
RECONCILE_STUCK_AFTER_SECONDS=60
RECONCILE_INTERVAL_SECONDS=10
# RECONCILE_BATCH_SIZE: most payments one pass will settle (default 100)
